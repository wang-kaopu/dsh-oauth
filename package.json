{
  "name": "@kelvinwww/dsh-oauth",
  "version": "0.2.0",
  "description": "OAuth bridge plugin for DeepSeek Harness Codex and Gemini CLI routes",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./storage": {
      "types": "./lib/storage.d.ts",
      "default": "./lib/storage.js"
    },
    "./codex": {
      "types": "./lib/codex.d.ts",
      "default": "./lib/codex.js"
    },
    "./gemini": {
      "types": "./lib/gemini.d.ts",
      "default": "./lib/gemini.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "watch:client": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.11.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "google-auth-library": "10.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@types/node": "22.15.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
